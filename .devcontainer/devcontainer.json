{
	"name": "loomtabulator",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"runArgs": [
		"--privileged",
		"-v", "/dev:/dev",
		"-v", "/dev/shm:/dev/shm",
		"-v", "/dev/hugepages:/dev/hugepages",
		"-v", "loomtabulator-workspace:/workspace",
		"-p", "8092:8080",
		"-p", "8093:8081",
		"-p", "8094:8082",
		"-p", "8095:8083",
		"-p", "8096:8084",
		"-p", "8097:8085"
	],
	"postCreateCommand": "bash .devcontainer/setup.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools"
			]
		}
	}
}
